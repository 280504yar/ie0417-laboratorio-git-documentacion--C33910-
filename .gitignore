# Entorno virtual de Python
.venv/
venv/
env/

# Caché de Python
__pycache__/
*.py[cod]
*$py.class

# Cachés de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Archivos temporales
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Archivos de sistema
.DS_Store
Thumbs.db
desktop.ini

# Configuración de editores
.vscode/
.idea/

# Credenciales y variables de entorno
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Dependencias o instalaciones locales
node_modules/

# Builds temporales
build/
dist/
*.egg-info/

# Repositorios de terceros clonados localmente
opencv/
numpy/

# Logs generales
*.log

# Excepción: conservar los logs requeridos por el laboratorio
!doxygen/build.log
!sphinx/build.log

# No ignorar el sitio generado porque forma parte de la entrega
!site/
!site/**